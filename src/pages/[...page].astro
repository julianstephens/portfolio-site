---
import About from "@components/about.astro";
import Footer from "@components/footer.astro";
import Head from "@components/head.astro";
import Header from "@components/header.astro";
import Page from "@components/page.astro";
import Post from "@components/post.astro";
import Wip from "@components/wip.astro";
import { page as pageConfig, site } from "@src/config";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

export const getStaticPaths = async ({ paginate }: { paginate: Function }) => {
  const allPosts = await getCollection("portfolio");
  const listed = allPosts.filter(
    (post) => !post.data.flags?.includes("unlisted"),
  );
  const wipPosts = listed
    .filter((post) => post.data.complete === false)
    .sort(
      (a, b) =>
        (b.data.published?.getTime() ?? b.data.created?.getTime() ?? 0) -
        (a.data.published?.getTime() ?? a.data.created?.getTime() ?? 0),
    );
  const posts = listed
    .filter((post) => post.data.complete !== false)
    .sort(
      (a, b) =>
        (b.data.published?.getTime() ?? b.data.created?.getTime() ?? 0) -
        (a.data.published?.getTime() ?? a.data.created?.getTime() ?? 0),
    );

  const pages = paginate(posts, { pageSize: pageConfig.pageSize ?? 5 });

  const pageRoutes = pages.map(({ params, props }: { params: { page?: string }; props: { page: PageData } }) => {
    return {
      params,
      props: { page: props.page },
    };
  });

  const postRoutes = [...posts, ...wipPosts].map((post) => {
    return {
      params: { page: post.id },
      props: { post },
    };
  });

  return [...pageRoutes, ...postRoutes];
};

type PageData = {
  data: CollectionEntry<"portfolio">[];
  start: number;
  end: number;
  size: number;
  total: number;
  currentPage: number;
  lastPage: number;
  url: {
    current: string;
    next?: string;
    prev?: string;
  };
};

const { page, post } = Astro.props as {
  page?: PageData;
  post?: CollectionEntry<"portfolio">;
};

const wipPosts = page
  ? (await getCollection("portfolio")).filter(
      (p) => !p.data.flags?.includes("unlisted") && p.data.complete === false,
    )
  : [];

import.meta.env.DEV && console.log(page ?? post);
---

<html lang={site.lang ?? "en"}>
  <head prefix="og: https://ogp.me/ns#">
    <Head page={page} post={post} />
  </head>
  <body class={page ? "h-feed" : ""} itemscope itemtype="https://schema.org/WebPage">
    <main itemprop="mainEntityOfPage" itemscope itemtype={page ? "https://schema.org/Blog" : ""}>
      <Header />
      {page?.currentPage === 1 && <About />}
      {page?.currentPage === 1 && <Wip posts={wipPosts} />}
      {post ? <Post post={post} /> : page ? <Page page={page} /> : null}
      <Footer />
    </main>
  </body>
</html>
