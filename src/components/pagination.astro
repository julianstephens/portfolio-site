---
type PageUrl = {
  current: string;
  next?: string;
  prev?: string;
};
const { url } = Astro.props as { url: PageUrl };
---

<nav aria-label="Pagination" class="flex justify-end gap-4 w-full max-w-content-md mx-auto px-4 sm:px-6 lg:px-8 my-8">
  {
    url.next != null && (
      <a
        href={url.next}
        rel="next"
        aria-label="Older posts"
        class="text-[#059669] dark:text-[#34d399] hover:underline transition-colors"
      >
        Older
      </a>
    )
  }
  {
    url.prev != null && (
      <a
        href={url.prev || "/"}
        rel="prev"
        aria-label="Newer posts"
        class="text-[#059669] dark:text-[#34d399] hover:underline transition-colors"
      >
        Newer
      </a>
    )
  }
</nav>
