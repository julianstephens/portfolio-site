---
import Date from "@components/post/date.astro";
import { page as pageConfig, site } from "@src/config";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

const { post, preview } = Astro.props as {
  post: CollectionEntry<"portfolio">;
  preview?: boolean;
};

const { Content } = await render(post);
const { data } = post;
const path = `/${post.id}`;
const date = data.published ?? data.created;
---

<article
  itemscope
  itemtype="https://schema.org/BlogPosting"
  itemprop="blogPost"
  class="h-entry w-full max-w-content-md mx-auto px-4 sm:px-6 lg:px-8"
>
  <a aria-hidden="true" style="display: none" class="u-url u-uid" href={site.url + path}>{path}</a>
  {
    preview && (
      <a itemprop="url" href={path} class="flex items-center gap-4 group no-underline">
        <div class="flex-1 min-w-0">
          <h4
            itemprop="name headline"
            class="text-lg sm:text-xl font-semibold mt-0 mb-1.5 border-0 group-hover:underline text-[#171717] dark:text-[#f5f5f5] u-url p-name"
          >
            {data.title}
          </h4>
          {data.summary && <p class="text-sm text-[#525252] dark:text-[#a3a3a3] mb-0">{data.summary}</p>}
        </div>
        {data.image && (
          <img
            src={data.image}
            alt={`${data.title} cover`}
            class="w-20 h-20 sm:w-24 sm:h-24 object-cover rounded-md flex-shrink-0"
            loading="lazy"
          />
        )}
      </a>
    )
  }

  <>
    {
      (!preview || pageConfig.preview?.content) && (
        <div class="prose prose-lg dark:prose-invert max-w-none e-content">
          {!preview && data.image && (
            <div class="not-prose mb-8 rounded-lg overflow-hidden bg-[#f5f5f5] dark:bg-[#1a1a1a]">
              <img src={data.image} alt={`${data.title} cover`} class="w-full h-auto object-contain" loading="eager" />
            </div>
          )}
          <Content />
          <div class="mt-16 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pt-6 border-t border-[#e5e5e5] dark:border-[#2a2a2a]">
            {data.repoUrl && (
              <a
                target="_blank"
                rel="noopener noreferrer"
                itemprop="url"
                href={data.repoUrl}
                aria-label={`View source code on GitHub (opens in new tab): ${data.repoUrl}`}
                class="text-[#059669] dark:text-[#34d399] hover:underline transition-colors break-all"
              >
                {data.repoUrl}
              </a>
            )}
            <div class="text-sm text-[#525252] dark:text-[#a3a3a3] whitespace-nowrap">
              Published on <Date date={date} />
            </div>
          </div>
        </div>
      )
    }
  </>
</article>

<script>
  function initMermaidZoom() {
    const mermaidEls = Array.from(document.querySelectorAll('pre.mermaid'));
    if (mermaidEls.length === 0) return;

    // Create modal once
    let modal = document.getElementById('mermaid-modal') as HTMLElement | null;
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'mermaid-modal';
      modal.className = 'mermaid-modal';
      modal.setAttribute('role', 'dialog');
      modal.setAttribute('aria-modal', 'true');
      modal.setAttribute('aria-label', 'Diagram fullscreen view');

      const closeBtn = document.createElement('button');
      closeBtn.className = 'mermaid-modal-close';
      closeBtn.textContent = '×';
      closeBtn.setAttribute('aria-label', 'Close diagram');

      const content = document.createElement('div');
      content.className = 'mermaid-modal-content';

      const hint = document.createElement('span');
      hint.className = 'mermaid-modal-hint';
      hint.textContent = 'Press Esc or click outside to close';

      modal.appendChild(closeBtn);
      modal.appendChild(content);
      content.appendChild(hint);
      document.body.appendChild(modal);

      function closeModal() {
        modal!.classList.remove('open');
        document.body.style.overflow = '';
      }

      closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });
    }

    const modalContent = modal.querySelector('.mermaid-modal-content') as HTMLElement;

    // Use MutationObserver to detect when mermaid renders SVGs
    function attachClickHandler(el: Element) {
      if ((el as HTMLElement).dataset.mermaidZoom) return;
      const svg = el.querySelector('svg');
      if (!svg) return;
      (el as HTMLElement).dataset.mermaidZoom = 'true';

      el.addEventListener('click', () => {
        const liveSvg = el.querySelector('svg');
        if (!liveSvg) return;
        // Clear previous content except hint
        const hint = modalContent.querySelector('.mermaid-modal-hint');
        modalContent.innerHTML = '';
        modalContent.appendChild(liveSvg.cloneNode(true));
        if (hint) modalContent.appendChild(hint);
        modal!.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    }

    // Attach to any already-rendered diagrams
    mermaidEls.forEach(attachClickHandler);

    // Watch for mermaid async rendering
    const observer = new MutationObserver(() => {
      mermaidEls.forEach(attachClickHandler);
    });

    mermaidEls.forEach((el) => {
      observer.observe(el, { childList: true, subtree: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMermaidZoom);
  } else {
    initMermaidZoom();
  }
</script>
