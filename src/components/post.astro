---
import Date from "@components/post/date.astro";
import { page as pageConfig, site } from "@src/config";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

const { post, preview } = Astro.props as {
  post: CollectionEntry<"portfolio">;
  preview?: boolean;
};

const { Content } = await render(post);
const { data } = post;
const path = `/${post.id}`;
const date = data.published ?? data.created;
---

<article itemscope itemtype="https://schema.org/BlogPosting" itemprop="blogPost" class="h-entry w-full max-w-content-md mx-auto px-4 sm:px-6 lg:px-8">
  <a style="display: none" class="u-url u-uid" href={site.url + path}>{path}</a>
  {
    preview && (
      <>
        <h4 itemprop="name headline" class="text-lg sm:text-xl font-semibold mt-0 mb-1.5 border-0">
          <a 
            itemprop="url" 
            class="text-[#171717] dark:text-[#f5f5f5] hover:underline cursor-pointer u-url p-name no-underline" 
            href={path}
          >
            {data.title}
          </a>
        </h4>
        {data.summary && <p class="text-sm text-[#525252] dark:text-[#a3a3a3] mb-0">{data.summary}</p>}
      </>
    )
  }

  <>
    {
      (!preview || pageConfig.preview?.content) && (
        <div class="prose prose-lg dark:prose-invert max-w-none e-content">
          <Content />
          <div class="mt-16 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pt-6 border-t border-[#e5e5e5] dark:border-[#2a2a2a]">
            {data.repoUrl && (
              <a 
                target="_blank"
                itemprop="url" 
                href={data.repoUrl}
                class="text-[#059669] dark:text-[#34d399] hover:underline transition-colors break-all"
              >
                {data.repoUrl}
              </a>
            )}
            <div class="text-sm text-[#525252] dark:text-[#a3a3a3] whitespace-nowrap">
              Published on <Date date={date} />
            </div>
          </div>
        </div>
      )
    }
  </>
</article>
