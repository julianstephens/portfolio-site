---
import ThemeToggle from "./theme-toggle.astro";
---

<header class="w-full max-w-content-md mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4">
    <div class="flex items-center justify-between">
      <a href="/" aria-label="Julian Stephens – home" class="hover:opacity-80 transition-opacity">
        <h3 class="text-xl sm:text-2xl font-bold m-0 text-[#171717] dark:text-[#f5f5f5]">Julian Stephens</h3>
      </a>
      <div class="sm:hidden">
        <ThemeToggle />
      </div>
    </div>
    <div class="flex items-center justify-between sm:justify-end gap-4">
      <div class="hidden sm:block">
        <ThemeToggle />
      </div>
    </div>
  </div>
  <hr class="mt-4 border-[#e5e5e5] dark:border-[#2a2a2a]" />
</header>
